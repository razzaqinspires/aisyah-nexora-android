NODE_ENV=development
PORT=3000

# PostgreSQL. Use a dedicated least-privilege application role.
DATABASE_URL=postgresql://nexora_runtime:CHANGE_ME@localhost:5432/nexora
DATABASE_POOL_MAX=10

# Firebase Admin: provide a path to a service-account JSON outside version control,
# or configure Application Default Credentials in the runtime environment.
GOOGLE_APPLICATION_CREDENTIALS=

# Local OpenAI-compatible/Ollama endpoint
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama4:scout
LOCAL_LLM_API_KEY=

# Optional cloud fallback (OpenAI-compatible API)
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=
CLOUD_LLM_API_KEY=

# Request limits
CHAT_MAX_INPUT_CHARS=12000
CHAT_TIMEOUT_MS=45000

# Optional OpenAI-compatible embeddings endpoint. Configure a model that returns
# exactly EMBEDDING_DIMENSIONS values (default 768; e.g. nomic-embed-text).
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=15000

# Comma-separated Firebase UIDs allowed to review shared-knowledge submissions
NEXORA_KNOWLEDGE_REVIEWER_UIDS=
